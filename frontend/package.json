{
  "name": "heatcity-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node src/sign-tracking.test.js && node src/video-frame.test.js",
    "test:e2e": "node scripts/sign-detection-smoke.mjs && node scripts/catalog-smoke.mjs",
    "format": "prettier --write src scripts vite.config.js index.html package.json",
